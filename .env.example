# ---------------------------------------------------------------------------
# MCU Endgame Preparation Quiz — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`, and never put real secrets in this file.
# Everything is server-side only except the NEXT_PUBLIC_FIREBASE_* web config
# for viewer sign-in, which is public by design. Firestore is still reached
# exclusively through the Admin SDK on the server.
# ---------------------------------------------------------------------------

# --- Firebase Admin credentials -------------------------------------------
# From: Firebase Console -> Project settings -> Service accounts
#       -> "Generate new private key" (downloads a JSON file)
#
# Option A (recommended): the three values as separate variables.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the literal \n escapes exactly as they appear in the JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# Option B (alternative): the whole service-account JSON in one variable,
# either raw JSON or base64-encoded. Leave blank if you used Option A.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Session signing -------------------------------------------------------
# Signs the HttpOnly quiz and admin cookies. Must be at least 16 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Admin panel -----------------------------------------------------------
# The organiser's sign-in for /admin. Change these before deploying.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-admin-password

# --- Device limit ----------------------------------------------------------
# One attempt per device as well as per name, so someone cannot simply enter a
# different name on the same phone or laptop. Recognition uses a browser
# fingerprint plus a long-lived signed cookie, and survives clearing cookies
# and local storage.
#
# Caveat: if several people share one device, only the first can play until you
# release that device from the organiser dashboard.
#
# Set to false to switch the whole mechanism off. Anything else (or unset)
# leaves it on.
DEVICE_LOCK_ENABLED=true

# --- Viewer accounts (email-link sign-in) ---------------------------------
# Lets visitors sign in with a link emailed by Firebase Auth and track what
# they have watched at /account. The browser uses Firebase only to send and
# complete the link; the server verifies the result with the Admin SDK above.
#
# From: Firebase Console -> Project settings -> General -> Your apps -> Web app
# (create one if there is none) -> SDK setup and configuration -> Config.
# These values are not secrets: they identify the project, nothing more.
#
# Also in the console:
#   Authentication -> Sign-in method -> Email/Password -> enable it AND
#     "Email link (passwordless sign-in)".
#   Authentication -> Settings -> Authorized domains -> add your production
#     domain (localhost is there by default).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project

# --- Optional --------------------------------------------------------------
# Absolute origin used for QR codes and ticket verification links.
# Leave unset locally and on Vercel; it is only needed behind a custom domain
# or a proxy that rewrites the host header.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
