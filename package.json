{
  "name": "mcu-endgame-prep-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "MCU Endgame Preparation Quiz - a cinematic Marvel Cinematic Universe knowledge test",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
